{
  "name": "pulse-uc13-segmentacao-alunos",
  "version": "1.0.0",
  "private": true,
  "description": "Fluxo UC-13 do Pulse Mais: consultar e segmentar alunos com testes de integracao.",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env DB_TYPE=sqljs ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:postgres": "cross-env DB_TYPE=postgres ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node src/database/migrate.ts",
    "test": "jest --runInBand",
    "test:postgres": "cross-env NODE_ENV=test DB_TYPE=postgres jest --runInBand"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "ejs": "^5.0.2",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.12.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
